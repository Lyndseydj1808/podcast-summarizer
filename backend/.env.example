SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/callback
SPOTIFY_PLAYLIST_ID=
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_SERVICE_ACCOUNT_FILE=your-service-account-file-name.json
GOOGLE_SHEET_ID=your_google_sheet_id_here
DATABASE_URL=postgresql://app_user:your_password_here@localhost:5432/podcast_summarizer

# Used by Docker Compose to set up the containerized Postgres service and to
# build its version of DATABASE_URL (which points at "db" instead of
# "localhost" inside Docker). Should match the pieces of DATABASE_URL above.
POSTGRES_USER=app_user
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=podcast_summarizer
